# Telegram Bot Environment Variables Template
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Telegram Bot Token (required)
# Get from: https://t.me/BotFather
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ============================================
# Telegram User ID (your personal user ID)
# Get from: https://t.me/userinfobot
# ============================================
TELEGRAM_USER_ID=your_user_id_here

# ============================================
# Agnes AI API Key (for image/video generation)
# Get from: https://apihub.agnes-ai.com
# ============================================
AGNES_API_KEY=your_agnes_api_key_here

# ============================================
# OpenRouter API Key (for model inference)
# Get from: https://openrouter.ai/keys
# ============================================
OPENROUTER_API_KEY=your_openrouter_key_here

# ============================================
# Nous Research API Key (fallback provider)
# Get from: https://nousresearch.com
# ============================================
NOUS_API_KEY=your_nous_key_here

# ============================================
# Cloudflare API Token (for MCP servers)
# Get from: https://dash.cloudflare.com -> My Profile -> API Tokens
# ============================================
CLOUDFLARE_API_TOKEN=your_cf_token_here
